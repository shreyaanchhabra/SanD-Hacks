{
  "manifest_version": 3,
  "name": "Exode Mascot",
  "version": "1.1.7",
  "description": "Shows the ExodeUI ip-2016 mascot and can speak its messages.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.elevenlabs.io/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["exode-mascot.js", "files/ip-2016.bexode"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
