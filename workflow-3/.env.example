# No credentials needed for npm run demo or default mock mode.
PLANNER_MODE=mock
PORT=4313
# Optional stable token; otherwise a random local token is printed at startup.
# LOCAL_API_TOKEN=
# Set both below and PLANNER_MODE=gemini for real model calls (may incur charges).
# GEMINI_API_KEY=
# GEMINI_MODEL=
# Optional: allow exactly the unpacked live connector's Chrome origin.
# ALLOWED_EXTENSION_ORIGIN=chrome-extension://YOUR_32_LETTER_EXTENSION_ID
# Optional speech; both values remain server-side.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=wqWIzbRnTn2yKnO6eeJS
# Optional local persistence directory (ignored by Git at the default location).
# TASK_STORAGE_DIR=.data
# Optional Tiger Cloud PostgreSQL connection (TLS required; requires both values; migrations run at startup).
# TIGER_DATA_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Use a stable, non-secret owner label. This is one-owner scoping, not user authentication.
# TIGER_OWNER_ID=your-stable-owner-id
