# No credentials needed for npm run demo or default mock mode.
PLANNER_MODE=mock
PORT=4313
# Optional stable token; otherwise a random local token is printed at startup.
# LOCAL_API_TOKEN=
# Set both below and PLANNER_MODE=gemini for real model calls (may incur charges).
# GEMINI_API_KEY=
# GEMINI_MODEL=
# Bright Data public-source retrieval. API key and SERP zone are required to enable it.
# BRIGHTDATA_API_KEY=
# BRIGHTDATA_SERP_ZONE=serp_api1
# BRIGHTDATA_TIMEOUT_MS=15000
# BRIGHTDATA_DAILY_BUDGET=20
# BRIGHTDATA_MINUTE_BUDGET=4
# Optional: allow exactly the unpacked live connector's Chrome origin.
# ALLOWED_EXTENSION_ORIGIN=chrome-extension://YOUR_32_LETTER_EXTENSION_ID
# Optional voice: API key enables transcription; voice ID also enables spoken replies. Both values remain server-side.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=wqWIzbRnTn2yKnO6eeJS
# Optional local persistence directory (ignored by Git at the default location).
# TASK_STORAGE_DIR=.data
# Optional Tiger Cloud PostgreSQL connection for reusable form/guidance cache.
# Can also be shared by the saved-journey/event tables by setting TIGER_OWNER_ID.
# TLS certificate verification is enabled for remote hosts.
# TIGER_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# Optional separate DB URL for saved journeys/events/public sources; must be paired with TIGER_OWNER_ID.
# TIGER_DATA_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# Stable, non-secret owner label for opt-in saved journeys and consented events.
# This is single-owner scoping, not user authentication.
# TIGER_OWNER_ID=your-stable-owner-id
# Tiger REST API credential (not consumed by this PostgreSQL app adapter).
# TIGER_API_KEY=
# Local Gemini spending guards, not provider quota guarantees.
# GEMINI_DAILY_BUDGET=20
# GEMINI_MINUTE_BUDGET=5
