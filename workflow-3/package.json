{
  "name": "accesspatch-workflow-3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --import tsx --env-file-if-exists=.env src/server.ts",
    "demo": "node --import tsx --env-file-if-exists=.env src/demo.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test:browser": "playwright test",
    "demo:page": "node tests/browser/fixture-server.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@mastra/core": "^1.83.0",
    "@mastra/libsql": "^1.30.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
