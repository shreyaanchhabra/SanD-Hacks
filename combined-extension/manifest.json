{
  "manifest_version": 3,
  "name": "AccessPatch \u2014 Guided Companion",
  "version": "0.4.0",
  "description": "A mascot companion for user-led page guidance, with optional reviewed visual help.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Open AccessPatch"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "exode-mascot.js",
        "files/ip-2016.bexode"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "key": "",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open or close the AccessPatch conversation"
    }
  }
}
